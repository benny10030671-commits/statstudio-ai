SET OLANG=ENGLISH OATTRS=BOTH PRINTBACK=OFF MPRINT=OFF THREADS=1.

DATA LIST FREE /study (A8) e1 n1 e2 n2.
BEGIN DATA
S1 12 100 18 98
S2 3 40 5 42
S3 0 30 2 31
S4 45 500 40 490
S5 8 60 19 58
S6 10 150 35 148
END DATA.
COMPUTE b=n1-e1.
COMPUTE d=n2-e2.
WEIGHT OFF.
SPLIT FILE OFF.
FILTER OFF.
EXECUTE.

OMS /SELECT ALL /DESTINATION FORMAT=OXML OUTFILE='C:/Users/office/Documents/ChatGPT/AA-AKI 2/statstudio-ai/validation/meta/spss30_reference/heterogeneous_or_dl.xml' VIEWER=NO /TAG='meta'.

META BINARY
/CRITERIA CILEVEL=95 MAXITER=1000 CONVERGENCE=1E-10 ZEROCOUNTS=ONLY ADD=0.5 DROP=TRUE
/DATA TREATMENT=SUCCESS(e1) FAILURE(b) CONTROL=SUCCESS(e2) FAILURE(d) ESTYPE=LOGOR STUDY=study
/INFERENCE MODEL=RANDOM ESTIMATE=DERSIMONIAN_LAIRD ADJUSTSE=NONE
/PRINT HOMOGENEITY HETEROGENEITY INDIVIDUAL PREDICTION EFORM(TRUE).

OMSEND TAG='meta'.

